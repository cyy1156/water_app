.agent-shell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 外壳稍微加宽，为更大的模型留空间 */
  width: 420rpx;
  box-sizing: border-box;
}

/* 使用 3D 粥粥图片 */
.agent-img {
  /* 人物模型整体放大一些（保持比例） */
  width: 220rpx;
  height: 260rpx;
  background: transparent;
  mix-blend-mode: multiply;
}

/* 对话气泡 */
.bubble {
  margin-top: 20rpx;
  max-width: 340rpx;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.95);
  box-shadow: 0 10rpx 26rpx rgba(0,0,0,0.12);
  display: flex;
  align-items: center;
}

.bubble-prefix {
  font-size: 22rpx;
  color: #2e7d32;
  margin-right: 6rpx;
}

.bubble-text {
  flex: 1;
  font-size: 24rpx;
  font-weight: 700;
  color: #2e3b2e;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}


