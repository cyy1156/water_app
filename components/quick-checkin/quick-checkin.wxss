.quick-checkin {
  border-radius: 16rpx;
  background: rgba(255,255,255,0.92);
  padding: 18rpx 18rpx 22rpx;
  box-shadow: 0 10rpx 26rpx rgba(0,0,0,0.08);
  box-sizing: border-box;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  width: calc(100% + 2rpx);
  margin-left: -2rpx;
}

.quick-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 0 0 calc((100% - 12rpx) / 2);
  max-width: calc((100% - 12rpx) / 2);
  height: 108rpx;
  border-radius: 12rpx;
  border: none;
  padding: 0;
  margin: 0;
}

.quick-btn::after {
  border: none;
}

.quick-btn .qb-main {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.quick-btn.outline .qb-main {
  color: inherit;
}

.quick-btn .qb-sub {
  font-size: 20rpx;
  color: rgba(255,255,255,0.88);
  margin-top: 4rpx;
}

.quick-btn.outline .qb-sub {
  color: inherit;
  opacity: 0.85;
}

.quick-btn.outline {
  border-width: 2rpx;
  border-style: solid;
}

.hint {
  margin-top: 14rpx;
  text-align: center;
}

.hint-text {
  font-size: 22rpx;
  color: rgba(46,59,46,0.55);
}
