.chat-card {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.bubble {
  max-width: 340rpx;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.95);
  box-shadow: 0 10rpx 26rpx rgba(0,0,0,0.12);
  display: flex;
  align-items: center;
}

.bubble-prefix {
  font-size: 22rpx;
  color: #2e7d32;
  margin-right: 6rpx;
}

.bubble-text {
  flex: 1;
  font-size: 24rpx;
  font-weight: 700;
  color: #2e3b2e;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
