/* pages/profile/profile.wxss 我的 + 商城（大升级） */
.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.hero {
  position: relative;
  height: 360rpx;
  overflow: hidden;
}

.hero-bg {
  width: 100%;
  height: 100%;
  filter: blur(16rpx);
  transform: scale(1.1);
}

.hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.18) 0%, rgba(245,245,245,1) 90%);
}

/* 名片栏：上边距为 hero 高度 20%（往下拉），下边距保持 */
.hero-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 72rpx;
  bottom: 18rpx;
  display: flex;
  gap: 20rpx;
  padding: 26rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.86);
  box-shadow: 0 12rpx 30rpx rgba(0,0,0,0.10);
  backdrop-filter: blur(10rpx);
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 999rpx;
  background: #fff;
}

.avatar.placeholder {
  /* 背景色由 wxml 中的内联样式 theme.avatarPlaceholderBg 控制 */
}

.hero-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.name {
  font-size: 40rpx;
  font-weight: 800;
  color: #1f2d1f;
}

.pill {
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(76,175,80,0.12);
  border: 2rpx solid rgba(76,175,80,0.22);
}

.pill-text {
  font-size: 28rpx;
  color: #2e7d32;
  font-weight: 700;
}

.row2 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.coin {
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

.coin-value {
  font-weight: 800;
  color: #FF9800;
  margin-left: 6rpx;
  font-size: 30rpx;
}

.stage {
  font-size: 28rpx;
  color: rgba(46,59,46,0.70);
}

.exp {
  margin-top: 12rpx;
}

.exp-bar {
  height: 16rpx;
  border-radius: 999rpx;
  background: rgba(0,0,0,0.06);
  overflow: hidden;
}

.exp-fill {
  height: 100%;
  border-radius: 999rpx;
  /* 背景色由 wxml 中的内联样式 theme.expGradient 控制 */
}

.exp-text {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(46,59,46,0.68);
}

.section {
  padding: 24rpx;
}

/* M5：设置行 */
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(0,0,0,0.08);
}

.setting-label {
  font-size: 28rpx;
  color: #2e3b2e;
}

.setting-value {
  font-size: 28rpx;
  font-weight: 700;
}

.setting-arrow {
  font-size: 28rpx;
  color: rgba(46,59,46,0.5);
}

.section-link {
  font-size: 26rpx;
}

/* M4：粥粥提醒 */
.reminder-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(0,0,0,0.08);
}

.reminder-label {
  font-size: 28rpx;
  color: #2e3b2e;
  font-weight: 700;
}

.reminder-switch {
  transform: scale(0.9);
}

.reminder-interval-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(0,0,0,0.06);
}

.reminder-interval-row .picker-value {
  font-size: 26rpx;
}

.reminder-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(46,59,46,0.60);
}

.reminder-preview {
  margin-top: 16rpx;
  padding: 16rpx;
  background: rgba(0,0,0,0.04);
  border-radius: 12rpx;
}

.reminder-preview-label {
  display: block;
  font-size: 22rpx;
  color: rgba(46,59,46,0.6);
  margin-bottom: 8rpx;
}

.reminder-preview-text {
  display: block;
  font-size: 26rpx;
  color: rgba(46,59,46,0.9);
  line-height: 1.4;
}

.reminder-preview-reason {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
}

.reminder-preview-reason.would-send {
  color: #4CAF50;
}

.reminder-preview-reason.would-not {
  color: rgba(46,59,46,0.6);
}

.reminder-btn {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  border-radius: 12rpx;
}

.reminder-btn::after {
  border: none;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2d1f;
}

.section-sub {
  font-size: 22rpx;
  color: rgba(46,59,46,0.60);
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.grid-item {
  border-radius: 16rpx;
  background: #fff;
  padding: 26rpx 18rpx;
  box-shadow: 0 10rpx 24rpx rgba(0,0,0,0.08);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.grid-item:active {
  transform: scale(0.99);
  opacity: 0.95;
}

.gi-icon {
  font-size: 40rpx;
}

.gi-text {
  font-size: 28rpx;
  color: #2e3b2e;
  font-weight: 700;
}

.goods-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.goods {
  display: flex;
  gap: 16rpx;
  border-radius: 16rpx;
  background: #fff;
  padding: 16rpx;
  box-shadow: 0 10rpx 24rpx rgba(0,0,0,0.08);
}

.goods-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  background: rgba(0,0,0,0.05);
}

.goods-img.placeholder {
  /* 背景色由 wxml 中的内联样式 theme.goodsPlaceholderBg 控制 */
}

.goods-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #1f2d1f;
}

.goods-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(46,59,46,0.62);
}

.goods-bottom {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price {
  display: flex;
  align-items: center;
}

.price-num {
  margin-left: 6rpx;
  font-weight: 900;
  color: #FF9800;
  font-size: 30rpx;
}

.buy-btn {
  border-radius: 12rpx;
  color: #fff;
  font-weight: 800;
  font-size: 26rpx;
  /* 背景色由 wxml 中的内联样式 theme.buyBtnBg 控制 */
}

.buy-btn.disabled {
  background: rgba(0,0,0,0.12);
  color: rgba(0,0,0,0.38);
}

