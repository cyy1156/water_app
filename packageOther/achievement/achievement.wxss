/* packageOther/achievement */
.page { min-height: 100vh; background: #f5f5f5; padding: 24rpx; }
.tabs { display: flex; background: #fff; border-radius: 16rpx; padding: 8rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06); }
.tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; color: #666; border-radius: 12rpx; transition: all 0.2s; }
.tab.active { font-weight: 600; }
.panel { min-height: 60vh; }
.section { margin-bottom: 36rpx; }
.section-title { font-size: 32rpx; font-weight: 700; color: #1f2d1f; margin-bottom: 8rpx; }
.section-desc { font-size: 24rpx; color: #666; margin-bottom: 20rpx; }
.list { display: flex; flex-direction: column; gap: 16rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06); }
.card.system { display: flex; align-items: center; gap: 24rpx; }
.badge { width: 80rpx; height: 80rpx; border-radius: 50%; background: linear-gradient(135deg, #4CAF50 0%, #8BC34A 100%); color: #fff; font-size: 22rpx; display: flex; align-items: center; justify-content: center; text-align: center; flex-shrink: 0; }
.info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.info .label { font-size: 28rpx; color: #333; font-weight: 600; }
.info .coin { font-size: 24rpx; color: #FF9800; }
.info .time { font-size: 22rpx; color: #999; }
.card.redeemed .goods-name, .card.pending .goods-name { font-size: 28rpx; color: #333; margin-bottom: 8rpx; }
.card.redeemed .time, .card.pending .time { font-size: 22rpx; color: #999; }
.card.pending { position: relative; padding-bottom: 80rpx; }
.card.pending .btn-done { position: absolute; right: 24rpx; bottom: 24rpx; padding: 14rpx 28rpx; font-size: 26rpx; color: #fff; border-radius: 12rpx; border: none; }
.card.pending .btn-done::after { border: none; }
.empty-tip { font-size: 26rpx; color: #999; padding: 32rpx 0; text-align: center; }
