.chat-container { display: flex; flex-direction: column; height: 100vh; background: #f5f5f5; }
.chat-messages { flex: 1; padding: 20rpx; overflow-y: auto; }
.message { margin-bottom: 20rpx; max-width: 70%; word-wrap: break-word; }
.message.user { margin-left: auto; background: #DCF8C6; border-radius: 16rpx 16rpx 0 16rpx; }
.message.assistant { margin-right: auto; background: white; border-radius: 16rpx 16rpx 16rpx 0; }
.message-content { padding: 15rpx 20rpx; font-size: 28rpx; line-height: 1.6; }
.message-image { width: 200rpx; height: 200rpx; border-radius: 8rpx; margin: 10rpx 20rpx; }
.empty { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: #999; padding: 40rpx; }
.empty-text { font-size: 32rpx; margin-bottom: 20rpx; font-weight: bold; }
.empty-hint { font-size: 24rpx; color: #bbb; text-align: center; line-height: 1.6; }
.loading { display: flex; align-items: center; justify-content: center; height: 100%; color: #999; }
.loading-text { font-size: 28rpx; }
.input-bar { display: flex; align-items: center; padding: 20rpx; background: white; border-top: 1rpx solid #eee; }
.input-btn { flex: 1; padding: 20rpx; background: #f5f5f5; color: #666; border-radius: 50rpx; font-size: 28rpx; border: none; text-align: center; }
.input-field { flex: 1; padding: 15rpx 20rpx; border-radius: 50rpx; background: #f5f5f5; font-size: 28rpx; }
.send-btn { margin-left: 20rpx; padding: 15rpx 30rpx; background: #2196F3; color: white; border-radius: 50rpx; font-size: 28rpx; border: none; }
