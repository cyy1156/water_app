.container { padding: 20rpx; background-color: #f5f5f5; min-height: 100vh; }
.today-card { background: white; border-radius: 16rpx; padding: 40rpx; margin-bottom: 30rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1); }
.title { font-size: 32rpx; color: #333; display: block; margin-bottom: 20rpx; }
.water-info { font-size: 48rpx; font-weight: bold; color: #4CAF50; margin-bottom: 30rpx; }
.current { color: #4CAF50; }
.target { font-size: 32rpx; color: #999; }
.checkin-btn { background-color: #2196F3; color: white; border-radius: 50rpx; padding: 20rpx 40rpx; font-size: 28rpx; border: none; width: 100%; }
.checkin-btn:active { opacity: 0.8; }
.history-section { background: white; border-radius: 16rpx; padding: 30rpx; }
.section-title { font-size: 32rpx; color: #333; margin-bottom: 20rpx; display: block; font-weight: bold; }
.history-list { min-height: 200rpx; }
.history-item { display: flex; justify-content: space-between; padding: 15rpx 0; border-bottom: 1rpx solid #eee; }
.history-item:last-child { border-bottom: none; }
.empty { text-align: center; padding: 60rpx 0; color: #999; }
.empty-text { font-size: 28rpx; }
