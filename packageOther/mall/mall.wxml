<view class="mall-container">
  <view class="points-info">
    <text class="points-label">当前金币</text>
    <text class="points-value">{{userPoints}}</text>
  </view>
  <view class="mall-desc">金币兑换自我奖励，喜欢就带走～</view>
  <view class="goods-list">
    <view class="goods-item" wx:for="{{goodsList}}" wx:key="id">
      <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" class="goods-img" mode="aspectFill"></image>
      <view wx:else class="goods-img-placeholder"><text class="placeholder-text">暂无图片</text></view>
      <text class="goods-name">{{item.name}}</text>
      <text class="goods-desc">{{item.description}}</text>
      <text class="goods-points">{{item.priceCoin || item.pointsRequired}} 金币</text>
      <button class="exchange-btn {{(item.priceCoin || item.pointsRequired) > userPoints ? 'disabled' : ''}}" bindtap="exchangeGoods" data-id="{{item.id}}" disabled="{{(item.priceCoin || item.pointsRequired) > userPoints}}">
        {{(item.priceCoin || item.pointsRequired) > userPoints ? '金币不足' : '兑换'}}
      </button>
    </view>
    <view class="empty" wx:if="{{goodsList.length === 0}}">
      <text class="empty-text">暂无自我奖励商品</text>
    </view>
  </view>
</view>
