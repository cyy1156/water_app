.mall-container { padding: 20rpx; background: #f5f5f5; min-height: 100vh; }
.points-info { background: white; padding: 30rpx; border-radius: 16rpx; margin-bottom: 30rpx; text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1); }
.points-label { display: block; font-size: 28rpx; color: #999; margin-bottom: 10rpx; }
.points-value { display: block; font-size: 48rpx; font-weight: bold; color: #FF9800; }
.mall-desc { display: block; font-size: 24rpx; color: #666; text-align: center; margin-bottom: 20rpx; }
.goods-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx; }
.goods-item { background: white; padding: 20rpx; border-radius: 16rpx; text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1); display: flex; flex-direction: column; align-items: center; }
.goods-img { width: 150rpx; height: 150rpx; border-radius: 8rpx; margin-bottom: 15rpx; background: #f5f5f5; }
.goods-img-placeholder { width: 150rpx; height: 150rpx; border-radius: 8rpx; margin-bottom: 15rpx; background: #f5f5f5; display: flex; align-items: center; justify-content: center; }
.placeholder-text { font-size: 20rpx; color: #999; }
.goods-name { font-size: 28rpx; color: #333; margin-bottom: 6rpx; font-weight: bold; }
.goods-desc { font-size: 22rpx; color: #999; margin-bottom: 8rpx; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.goods-points { font-size: 24rpx; color: #FF9800; margin-bottom: 15rpx; }
.exchange-btn { background: #FF9800; color: white; border-radius: 20rpx; padding: 10rpx 20rpx; font-size: 24rpx; margin-top: 10rpx; border: none; width: 100%; }
.exchange-btn.disabled { background: #e0e0e0; color: #999; }
.empty { grid-column: 1 / -1; text-align: center; padding: 100rpx 20rpx; color: #999; }
.empty-text { font-size: 28rpx; }
